# ============================================================
#  Gamefy — Production Environment Variables
#  Usage: docker compose --env-file .env.production up -d --build
# ============================================================

# ── PostgreSQL ──
POSTGRES_DB=gamefy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5432

# ── Redis ──
REDIS_PORT=6379

# ── Backend ──
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost,http://localhost:8081,http://GamefyAcademy.tn,http://GamefyAcademy.tn:8081,https://GamefyAcademy.tn,https://GamefyAcademy.tn:8081

# ── Frontend Build Args ──
VITE_API_BASE_URL=http://GamefyAcademy.tn:8080/api

# ── Front-Office ──
FRONT_OFFICE_PORT=80

# ── Back-Office ──
BACK_OFFICE_PORT=8081

